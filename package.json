{
  "name": "v4",
  "description": "Personal Website V4",
  "version": "1.0.0",
  "author": "Brittany Chiang <brittany.chiang@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/bchiang7/v4"
  },
  "keywords": [
    "gatsby"
  ],
  "license": "MIT",
  "browserslist": "> 0.25%, not dead",
  "scripts": {
    "build": "gatsby build && node scripts/fix-sitemap.js && node scripts/post-build.js",
    "build:original": "gatsby build",
    "build:cf": "npm run clean && GATSBY_CACHE=false gatsby build --no-color && node scripts/fix-sitemap.js",
    "build:no-cache": "npm run clean && gatsby build --no-color --verbose",
    "develop": "gatsby develop",
    "format": "prettier --write \"**/*.{js,jsx,json,md}\"",
    "start": "npm run develop",
    "serve": "gatsby serve",
    "clean": "gatsby clean && rm -rf .cache && rm -rf public",
    "prepare": "husky install",
    "lint-staged": "lint-staged"
  },
  "lint-staged": {
    "*.{js,css,json,md}": [
      "prettier --write"
    ],
    "*.js": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "animejs": "^3.1.0",
    "babel-plugin-styled-components": "^2.0.7",
    "core-js": "^3.38.0",
    "gatsby": "^5.15.0",
    "gatsby-plugin-google-analytics": "^5.0.0",
    "gatsby-plugin-image": "^3.0.0",
    "gatsby-plugin-manifest": "^5.0.0",
    "gatsby-plugin-react-helmet": "^6.0.0",
    "gatsby-plugin-robots-txt": "^1.7.1",
    "gatsby-plugin-sharp": "^5.0.0",
    "gatsby-plugin-sitemap": "^6.0.0",
    "gatsby-plugin-styled-components": "^6.0.0",
    "gatsby-remark-external-links": "0.0.4",
    "gatsby-remark-images": "^6.0.0",
    "gatsby-remark-prismjs": "^7.0.0",
    "gatsby-source-filesystem": "^5.0.0",
    "gatsby-transformer-remark": "^6.0.0",
    "gatsby-transformer-sharp": "^5.0.0",
    "lodash": "^4.17.19",
    "prismjs": "^1.29.0",
    "prop-types": "^15.8.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-helmet": "^6.1.0",
    "react-is": "^18.2.0",
    "react-transition-group": "^4.4.5",
    "scrollreveal": "^4.0.5",
    "smooth-scroll": "^16.1.0",
    "styled-components": "^5.3.5"
  },
  "devDependencies": {
    "@babel/core": "^7.23.5",
    "@babel/eslint-parser": "^7.18.9",
    "@babel/preset-react": "^7.13.13",
    "@upstatement/eslint-config": "^1.0.1",
    "@upstatement/prettier-config": "^1.0.0",
    "babel-preset-gatsby": "^3.12.1",
    "eslint": "^7.25.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-jsx-a11y": "^6.6.1",
    "eslint-plugin-react": "^7.30.1",
    "gatsby-remark-code-titles": "^1.1.0",
    "husky": "^8.0.1",
    "lint-staged": "^12.1.7",
    "prettier": "^2.7.1"
  }
}
