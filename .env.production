# Cloudflare Pages - Disable ALL caching completely
SKIP_CACHE=true
DISABLE_CACHE=true
GATSBY_CACHE=false
GATSBY_DISABLE_CACHING=true
CI_CACHE_DISABLED=true
NO_CACHE=true
GATSBY_SKIP_WRITING_SCHEMA_TO_FILE=true
GATSBY_DISABLE_CACHE_PERSISTENCE=true
GATSBY_EXPERIMENTAL_DISABLE_CACHE=true

# Sharp package configuration for Cloudflare
SHARP_IGNORE_GLOBAL_LIBVIPS=1
SHARP_FORCE_GLOBAL_LIBVIPS=false
SHARP_DOWNLOAD_HOST=https://github.com/lovell/sharp-libvips/releases/download
SHARP_VENDOR_PATH=/tmp/vendor
SHARP_TIMEOUT=300000

# Build environment optimization
NODE_OPTIONS="--max-old-space-size=4096"
GATSBY_BUILD_TIMEOUT=600000

# Cloudflare will handle all caching
CLOUDFLARE_CACHE=true